rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada persona solo puede leer y escribir sus propios datos: users/{su uid}/items/...
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Forma que debe tener cada documento que escribe la app
    function validItem(itemId) {
      let d = request.resource.data;
      return itemId.size() <= 60
        && d.keys().hasOnly(['col', 'data', 'o', 'updatedAt'])
        && d.col in ['classes', 'events', 'tasks', 'projects', 'notes', 'links', 'meta']
        && d.data is map
        && (!('o' in d) || d.o is int)
        && (!('updatedAt' in d) || d.updatedAt == request.time);
    }

    match /users/{uid}/items/{itemId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validItem(itemId);
    }

    // Cualquier otra ruta queda cerrada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
